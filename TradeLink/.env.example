# Copy to .env.local (git-ignored) and fill in. Never put the Supabase service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Public contact buttons (leave empty to hide a channel)
VITE_CONTACT_PHONE=
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_TELEGRAM=

# Optional: Cloudflare Turnstile site key (public). Enables the CAPTCHA on the quote form.
# Also needs the submit-quote Edge Function + TURNSTILE_SECRET_KEY (README 6d).
VITE_TURNSTILE_SITE_KEY=
